{
	"name": "vscode-vlang",
	"displayName": "V",
	"description": "V language support with VLS, tasks, test coverage, syntax highlighting, and snippets for Visual Studio Code.",
	"publisher": "vlanguage",
	"icon": "icons/icon.png",
	"version": "0.3.0",
	"license": "GPL-2.0-only",
	"engines": {
		"vscode": "^1.105.0"
	},
	"homepage": "https://vlang.io/",
	"bugs": {
		"url": "https://github.com/vlang/vscode-vlang/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/vlang/vscode-vlang"
	},
	"scripts": {
		"build:base": "esbuild src/extension.ts --bundle --external:vscode --outdir=out --platform=node --target=node24 --format=cjs",
		"build": "npm run build:base -- --sourcemap",
		"build:prod": "npm run build:base -- --minify",
		"watch": "npm run build:base -- --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint src --deny-warnings",
		"lint:md": "markdownlint README.md",
		"fmt": "oxfmt --write .",
		"test": "npm run typecheck && npm run lint && npm run fmt:check && npm run test:logic && npm run test:tools",
		"test:logic": "esbuild src/test/extension.test.ts --bundle --platform=node --target=node24 --format=cjs --outfile=out/test/extension.test.js && node --test out/test/extension.test.js",
		"test:vscode": "npm run build && esbuild src/test/vscode.integration.ts --bundle --external:vscode --platform=node --target=node24 --format=cjs --outfile=out/test/vscode.integration.js && node scripts/test-vscode.cjs",
		"vscode:prepublish": "npm run build:prod",
		"package": "vsce package",
		"test:grammar": "vscode-tmgrammar-test source.v -g syntaxes/v.tmLanguage.json  syntaxes/tests/*.v",
		"test:tools": "node scripts/test-tool-manager.cjs",
		"fmt:check": "oxfmt --check ."
	},
	"keywords": [
		"V",
		"v",
		"v language",
		"vlang",
		"extension",
		"autocompletion"
	],
	"categories": [
		"Snippets",
		"Programming Languages"
	],
	"contributes": {
		"snippets": [
			{
				"language": "v",
				"path": "snippets/snippets.json"
			}
		],
		"languages": [
			{
				"id": "v",
				"aliases": [
					"V",
					"v"
				],
				"extensions": [
					".v",
					".vsh",
					".vh",
					".vv"
				],
				"configuration": "language-configuration.json"
			},
			{
				"id": "v.mod",
				"aliases": [
					"v.mod"
				],
				"extensions": [
					"v.mod"
				],
				"configuration": "language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "v",
				"scopeName": "source.v",
				"path": "syntaxes/v.tmLanguage.json"
			},
			{
				"language": "v.mod",
				"scopeName": "v.mod",
				"path": "syntaxes/v.mod.tmLanguage.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "V",
			"properties": {
				"v.vls.command": {
					"scope": "resource",
					"type": "string",
					"default": "",
					"description": "Path or command name for VLS. Defaults to vls in PATH. Supports ~, ${env:NAME}, and ${workspaceFolder}."
				},
				"v.vls.args": {
					"scope": "resource",
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"description": "Arguments to pass to the V language server."
				},
				"v.executablePath": {
					"scope": "resource",
					"type": "string",
					"default": "v",
					"description": "V compiler for tasks and formatting; VLS uses the active or first workspace folder at startup. Supports absolute paths, ~, ${env:NAME}, and ${workspaceFolder}."
				},
				"v.vls.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable the V language server."
				},
				"v.vls.inlayHints.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable inlay hints from VLS."
				},
				"v.vls.diagnostics": {
					"type": "boolean",
					"default": true,
					"description": "Enable live diagnostics from VLS."
				},
				"v.vls.coverage.enabled": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "Collect test coverage and highlight covered and uncovered executable lines after V test tasks."
				},
				"v.tools.checkForUpdates": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "Check official V and VLS upstream revisions at most once a day and offer updates. Missing tools still prompt for installation. No installation or update runs without confirmation."
				}
			}
		},
		"taskDefinitions": [
			{
				"type": "v",
				"required": [
					"action"
				],
				"properties": {
					"action": {
						"type": "string",
						"description": "The V operation to run.",
						"enum": [
							"build",
							"run",
							"test",
							"prod"
						],
						"enumDescriptions": [
							"Build the workspace with v .",
							"Run the workspace with v run .",
							"Test the workspace with v test .",
							"Build an optimized executable with v -prod ."
						]
					}
				}
			}
		],
		"problemMatchers": [
			{
				"name": "vls",
				"label": "V compiler diagnostics",
				"owner": "v",
				"severity": "info",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s*(error|warning|notice):\\s*(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			}
		],
		"configurationDefaults": {
			"[v]": {
				"editor.insertSpaces": false
			}
		},
		"keybindings": [
			{
				"command": "v.fmt",
				"key": "ctrl+shift+i",
				"when": "editorTextFocus && editorLangId == v && !editorReadonly"
			}
		],
		"commands": [
			{
				"command": "vls.build",
				"title": "Build",
				"category": "V"
			},
			{
				"command": "vls.run",
				"title": "Run",
				"category": "V"
			},
			{
				"command": "vls.test",
				"title": "Test",
				"category": "V"
			},
			{
				"command": "vls.coverage.clear",
				"title": "Clear Test Coverage",
				"category": "V"
			},
			{
				"command": "v.run",
				"title": "Run current file",
				"category": "V"
			},
			{
				"command": "v.fmt",
				"title": "Format current file",
				"category": "V"
			},
			{
				"command": "v.prod",
				"title": "Build optimized module",
				"category": "V"
			},
			{
				"command": "v.ver",
				"title": "Show V version",
				"category": "V"
			},
			{
				"command": "v.vls.restart",
				"title": "Restart VLS",
				"category": "V"
			},
			{
				"command": "v.vls.openOutput",
				"title": "Show Language Server Output",
				"category": "V"
			},
			{
				"command": "v.install",
				"title": "Install or Update V",
				"category": "V"
			},
			{
				"command": "v.vls.update",
				"title": "Install or Update VLS",
				"category": "V"
			},
			{
				"command": "v.tools.checkForUpdates",
				"title": "Check for Tool Updates",
				"category": "V"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "v.run",
					"when": "editorLangId == v"
				},
				{
					"command": "v.fmt",
					"when": "editorLangId == v"
				},
				{
					"command": "v.prod",
					"when": "editorLangId == v"
				},
				{
					"command": "v.vls.restart",
					"when": "config.v.vls.enable"
				}
			]
		},
		"breakpoints": [
			{
				"language": "v"
			}
		]
	},
	"activationEvents": [
		"workspaceContains:**/*.v",
		"onLanguage:v",
		"onTaskType:v"
	],
	"main": "./out/extension.js",
	"overrides": {
		"markdownlint-cli": {
			"js-yaml": "^5.4.2"
		}
	},
	"dependencies": {
		"vscode-languageclient": "10.1.2"
	},
	"devDependencies": {
		"@types/node": "^24.19.0",
		"@types/vscode": "1.105.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"markdownlint-cli": "^0.49.1",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^7.0.2",
		"vscode-tmgrammar-test": "^0.1.3"
	}
}
