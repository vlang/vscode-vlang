{
	"name": "vscode-vlang",
	"displayName": "V",
	"description": "V language support with VLS, tasks, test coverage, syntax highlighting, and snippets for Visual Studio Code.",
	"publisher": "vlanguage",
	"icon": "icons/icon.png",
	"version": "0.2.1",
	"license": "GPL-2.0-only",
	"engines": {
		"vscode": "^1.105.0"
	},
	"extensionPack": [
		"ms-vscode.cpptools"
	],
	"homepage": "https://vlang.io/",
	"bugs": {
		"url": "https://github.com/vlang/vscode-vlang/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/vlang/vscode-vlang"
	},
	"scripts": {
		"build:base": "esbuild src/extension.ts --bundle --external:vscode --outdir=out --platform=node --target=node24 --format=cjs",
		"build": "npm run build:base -- --sourcemap",
		"build:prod": "npm run build:base -- --minify",
		"watch": "npm run build:base -- --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:md": "markdownlint README.md",
		"fmt": "prettier -w .",
		"fmt:check": "prettier --check .",
		"test": "npm run typecheck && npm run lint && npm run test:logic",
		"test:logic": "esbuild src/test/extension.test.ts src/test/testSkeleton.test.ts src/test/debugCompile.test.ts src/test/playground.test.ts src/test/fillStruct.test.ts src/test/decodeStruct.test.ts src/test/convert.test.ts src/test/vpm.test.ts src/test/numberHover.test.ts src/test/docTables.test.ts src/test/importsCleanup.test.ts src/test/canonicalPath.test.ts src/test/saveDocuments.test.ts --bundle --platform=node --target=node24 --format=cjs --outdir=out/test && node --test out/test/extension.test.js out/test/testSkeleton.test.js out/test/debugCompile.test.js out/test/playground.test.js out/test/fillStruct.test.js out/test/decodeStruct.test.js out/test/convert.test.js out/test/vpm.test.js out/test/numberHover.test.js out/test/docTables.test.js out/test/importsCleanup.test.js out/test/canonicalPath.test.js out/test/saveDocuments.test.js",
		"test:vscode": "npm run build && esbuild src/test/vscode.integration.ts --bundle --external:vscode --platform=node --target=node24 --format=cjs --outfile=out/test/vscode.integration.js && node scripts/test-vscode.cjs",
		"vscode:prepublish": "npm run build:prod",
		"package": "npm run build:prod && vsce package",
		"test:grammar": "vscode-tmgrammar-test source.v -g syntaxes/v.tmLanguage.json  syntaxes/tests/*.v"
	},
	"keywords": [
		"V",
		"v",
		"v language",
		"vlang",
		"extension",
		"autocompletion"
	],
	"categories": [
		"Snippets",
		"Programming Languages"
	],
	"contributes": {
		"snippets": [
			{
				"language": "v",
				"path": "snippets/snippets.json"
			},
			{
				"language": "v",
				"path": "snippets/veb.json"
			}
		],
		"languages": [
			{
				"id": "v",
				"aliases": [
					"V",
					"v"
				],
				"extensions": [
					".v",
					".vsh",
					".vh",
					".vv"
				],
				"configuration": "language-configuration.json"
			},
			{
				"id": "v.mod",
				"aliases": [
					"v.mod"
				],
				"extensions": [
					"v.mod"
				],
				"configuration": "language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "v",
				"scopeName": "source.v",
				"path": "syntaxes/v.tmLanguage.json"
			},
			{
				"language": "v.mod",
				"scopeName": "v.mod",
				"path": "syntaxes/v.mod.tmLanguage.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "V",
			"properties": {
				"v.vls.command": {
					"type": "string",
					"default": "",
					"description": "Path or command name for the V language server binary. If empty, the extension looks for `vls` in PATH."
				},
				"v.vls.args": {
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"description": "Arguments to pass to the V language server."
				},
				"v.executablePath": {
					"scope": "resource",
					"type": "string",
					"default": "v",
					"description": "Path or command name of the V compiler used by VLS and V build, run, and test tasks. Supports absolute paths, ~, ${env:NAME}, and ${workspaceFolder}."
				},
				"v.vls.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable the V language server."
				},
				"v.vls.inlayHints.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable inlay hints from VLS."
				},
				"v.vls.diagnostics": {
					"type": "boolean",
					"default": true,
					"description": "Enable live diagnostics from VLS."
				},
				"v.vls.coverage.enabled": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "Collect test coverage and highlight covered and uncovered executable lines after V test tasks."
				},
				"vls.command": {
					"type": "string",
					"default": "",
					"markdownDeprecationMessage": "Deprecated: use `v.vls.command` instead.",
					"description": "Deprecated alias of `v.vls.command`. Kept so settings from the former VLS extension keep working."
				},
				"vls.args": {
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"markdownDeprecationMessage": "Deprecated: use `v.vls.args` instead.",
					"description": "Deprecated alias of `v.vls.args`. Kept so settings from the former VLS extension keep working."
				},
				"vls.vCommand": {
					"scope": "resource",
					"type": "string",
					"default": "v",
					"markdownDeprecationMessage": "Deprecated: use `v.executablePath` instead.",
					"description": "Deprecated alias of `v.executablePath`. Kept so settings from the former VLS extension keep working."
				},
				"vls.inlayHints.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDeprecationMessage": "Deprecated: use `v.vls.inlayHints.enabled` instead.",
					"description": "Deprecated alias of `v.vls.inlayHints.enabled`. Kept so settings from the former VLS extension keep working."
				},
				"vls.diagnostics.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDeprecationMessage": "Deprecated: use `v.vls.diagnostics` instead.",
					"description": "Deprecated alias of `v.vls.diagnostics`. Kept so settings from the former VLS extension keep working."
				},
				"vls.coverage.enabled": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"markdownDeprecationMessage": "Deprecated: use `v.vls.coverage.enabled` instead.",
					"description": "Deprecated alias of `v.vls.coverage.enabled`. Kept so settings from the former VLS extension keep working."
				}
			}
		},
		"taskDefinitions": [
			{
				"type": "v",
				"required": [
					"action"
				],
				"properties": {
					"action": {
						"type": "string",
						"description": "The V operation to run.",
						"enum": [
							"build",
							"run",
							"test",
							"prod"
						],
						"enumDescriptions": [
							"Build the workspace with v .",
							"Run the workspace with v run .",
							"Test the workspace with v test .",
							"Build an optimized executable with v -prod ."
						]
					}
				}
			}
		],
		"problemMatchers": [
			{
				"name": "vls",
				"label": "V compiler diagnostics",
				"owner": "v",
				"severity": "info",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s*(error|warning|notice):\\s*(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			}
		],
		"configurationDefaults": {
			"[v]": {
				"editor.insertSpaces": false
			}
		},
		"keybindings": [
			{
				"command": "v.fmt",
				"key": "ctrl+shift+i"
			}
		],
		"commands": [
			{
				"command": "vls.build",
				"title": "Build",
				"category": "V"
			},
			{
				"command": "vls.run",
				"title": "Run",
				"category": "V"
			},
			{
				"command": "vls.test",
				"title": "Test",
				"category": "V"
			},
			{
				"command": "vls.coverage.clear",
				"title": "Clear Test Coverage",
				"category": "V"
			},
			{
				"command": "v.run",
				"title": "Run current file",
				"category": "V"
			},
			{
				"command": "v.fmt",
				"title": "Format current file",
				"category": "V"
			},
			{
				"command": "v.prod",
				"title": "Build an optimized executable from current file",
				"category": "V"
			},
			{
				"command": "v.generateTestFile",
				"title": "Generate Test File",
				"category": "V"
			},
			{
				"command": "v.toggleTestFile",
				"title": "Toggle Test File",
				"category": "V"
			},
			{
				"command": "v.fillStruct",
				"title": "Fill Struct Fields",
				"category": "V"
			},
			{
				"command": "v.sharePlayground",
				"title": "Share on Playground",
				"category": "V"
			},
			{
				"command": "v.ver",
				"title": "Show V version",
				"category": "V"
			},
			{
				"command": "v.vls.update",
				"title": "Update VLS",
				"category": "V"
			},
			{
				"command": "v.vls.restart",
				"title": "Restart VLS",
				"category": "V"
			},
			{
				"command": "v.debugMain",
				"title": "Debug Main",
				"category": "V"
			},
			{
				"command": "v.generateJsonDecoder",
				"title": "Generate JSON Decoder",
				"category": "V"
			},
			{
				"command": "v.generateXmlDecoder",
				"title": "Generate XML Decoder",
				"category": "V"
			},
			{
				"command": "v.generateCsvDecoder",
				"title": "Generate CSV Decoder",
				"category": "V"
			},
			{
				"command": "v.convertEncoding",
				"title": "Convert Selection Encoding",
				"category": "V"
			},
			{
				"command": "v.organizeImports",
				"title": "Organize Imports",
				"category": "V"
			},
			{
				"command": "v.vpmSearch",
				"title": "Search VPM Modules",
				"category": "V"
			},
			{
				"command": "v.vpmList",
				"title": "List Installed VPM Modules",
				"category": "V"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "v.run",
					"when": "editorLangId == v"
				},
				{
					"command": "v.fmt",
					"when": "editorLangId == v"
				},
				{
					"command": "v.prod",
					"when": "editorLangId == v"
				},
				{
					"command": "v.toggleTestFile",
					"when": "editorLangId == v"
				},
				{
					"command": "v.generateJsonDecoder",
					"when": "editorLangId == json"
				},
				{
					"command": "v.generateXmlDecoder",
					"when": "editorLangId == xml"
				},
				{
					"command": "v.generateCsvDecoder",
					"when": "editorLangId == csv || (editorLangId == plaintext && resourceExtname == .csv)"
				},
				{
					"command": "v.convertEncoding",
					"when": "editorHasSelection"
				},
				{
					"command": "v.organizeImports",
					"when": "editorLangId == v"
				},
				{
					"command": "v.vpmSearch"
				},
				{
					"command": "v.vpmList"
				},
				{
					"command": "v.fillStruct",
					"when": "editorLangId == v"
				},
				{
					"command": "v.sharePlayground",
					"when": "editorLangId == v"
				},
				{
					"command": "v.debugMain",
					"when": "editorLangId == v"
				},
				{
					"command": "v.vls.restart",
					"when": "editorLangId == v && config.v.vls.enable"
				}
			],
			"editor/title": [
				{
					"command": "v.generateJsonDecoder",
					"when": "editorLangId == json",
					"group": "navigation"
				},
				{
					"command": "v.generateXmlDecoder",
					"when": "editorLangId == xml",
					"group": "navigation"
				},
				{
					"command": "v.generateCsvDecoder",
					"when": "editorLangId == csv || (editorLangId == plaintext && resourceExtname == .csv)",
					"group": "navigation"
				}
			]
		},
		"breakpoints": [
			{
				"language": "v"
			}
		],
		"debuggers": [
			{
				"type": "v",
				"label": "V",
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "The V source file to debug.",
								"default": "${file}"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Arguments passed to the program.",
								"default": []
							},
							"stopAtEntry": {
								"type": "boolean",
								"description": "Break at the start of the program.",
								"default": false
							},
							"cwd": {
								"type": "string",
								"description": "Working directory for the program. Defaults to the workspace folder.",
								"default": "${workspaceFolder}"
							},
							"miDebuggerPath": {
								"type": "string",
								"description": "Path or command name of the MI debugger. Supports absolute paths, ~, ${env:NAME}, and ${workspaceFolder}. Empty means the MIMode default on PATH.",
								"default": ""
							},
							"MIMode": {
								"type": "string",
								"enum": [
									"gdb",
									"lldb"
								],
								"description": "The MI debugger to run the session under. The V pretty printers only load under gdb.",
								"default": "gdb"
							},
							"setupCommands": {
								"type": "array",
								"items": {
									"type": "object",
									"required": [
										"text"
									],
									"properties": {
										"description": {
											"type": "string"
										},
										"text": {
											"type": "string",
											"description": "An MI command to run after the debugger starts, e.g. GDB skip rules for generated frames."
										},
										"ignoreFailures": {
											"type": "boolean"
										}
									}
								},
								"description": "Extra MI setup commands, run after the pretty-printer commands under gdb.",
								"default": []
							},
							"environment": {
								"type": "array",
								"items": {
									"type": "object",
									"required": [
										"name",
										"value"
									],
									"properties": {
										"name": {
											"type": "string"
										},
										"value": {
											"type": "string"
										}
									}
								},
								"description": "Environment variables for the debugged program."
							},
							"envFile": {
								"type": "string",
								"description": "Path to a KEY=VALUE environment file for the debugged program. Entries overwrite environment."
							},
							"externalConsole": {
								"type": "boolean",
								"description": "Run the program in an external console instead of the integrated terminal.",
								"default": false
							},
							"sourceFileMap": {
								"type": "object",
								"description": "Map build paths to local source paths, e.g. for remote targets."
							},
							"miDebuggerServerAddress": {
								"type": "string",
								"description": "Address of a remote MI debugger server, e.g. localhost:2345."
							},
							"pipeTransport": {
								"type": "object",
								"required": [
									"pipeProgram",
									"debuggerPath"
								],
								"properties": {
									"pipeProgram": {
										"type": "string"
									},
									"pipeArgs": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"pipeCwd": {
										"type": "string"
									},
									"pipeEnv": {
										"type": "object"
									},
									"debuggerPath": {
										"type": "string"
									}
								},
								"description": "Reach a remote debugger through a pipe program such as ssh."
							}
						}
					},
					"attach": {
						"required": [
							"program",
							"processId"
						],
						"properties": {
							"program": {
								"type": "string",
								"description": "Path to the running binary, for symbols. Nothing is compiled on attach."
							},
							"processId": {
								"type": "string",
								"description": "Process ID to attach to. ${command:pickProcess} shows the adapter's process picker.",
								"default": "${command:pickProcess}"
							},
							"cwd": {
								"type": "string",
								"description": "Working directory for expression evaluation. Defaults to the workspace folder.",
								"default": "${workspaceFolder}"
							},
							"miDebuggerPath": {
								"type": "string",
								"description": "Path or command name of the MI debugger. Supports absolute paths, ~, ${env:NAME}, and ${workspaceFolder}. Empty means the MIMode default on PATH.",
								"default": ""
							},
							"MIMode": {
								"type": "string",
								"enum": [
									"gdb",
									"lldb"
								],
								"description": "The MI debugger to run the session under. The V pretty printers only load under gdb.",
								"default": "gdb"
							},
							"setupCommands": {
								"type": "array",
								"items": {
									"type": "object",
									"required": [
										"text"
									],
									"properties": {
										"description": {
											"type": "string"
										},
										"text": {
											"type": "string"
										},
										"ignoreFailures": {
											"type": "boolean"
										}
									}
								},
								"description": "Extra MI setup commands, run after the pretty-printer commands under gdb.",
								"default": []
							},
							"sourceFileMap": {
								"type": "object",
								"description": "Map build paths to local source paths, e.g. for remote targets."
							},
							"miDebuggerServerAddress": {
								"type": "string",
								"description": "Address of a remote MI debugger server, e.g. localhost:2345."
							},
							"pipeTransport": {
								"type": "object",
								"required": [
									"pipeProgram",
									"debuggerPath"
								],
								"properties": {
									"pipeProgram": {
										"type": "string"
									},
									"pipeArgs": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"pipeCwd": {
										"type": "string"
									},
									"pipeEnv": {
										"type": "object"
									},
									"debuggerPath": {
										"type": "string"
									}
								},
								"description": "Reach a remote debugger through a pipe program such as ssh."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "v",
						"request": "launch",
						"name": "Debug V Program",
						"program": "${file}",
						"stopAtEntry": false
					}
				]
			}
		]
	},
	"activationEvents": [
		"workspaceContains:**/*.v",
		"workspaceContains:**/*.xml",
		"workspaceContains:**/*.csv",
		"onLanguage:v",
		"onLanguage:json",
		"onLanguage:xml",
		"onTaskType:v"
	],
	"main": "./out/extension.js",
	"dependencies": {
		"vscode-languageclient": "10.1.0"
	},
	"devDependencies": {
		"@types/node": "24",
		"@types/vscode": "1.105.0",
		"@typescript-eslint/eslint-plugin": "^8.46",
		"@typescript-eslint/parser": "^8.46",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.6.2",
		"esbuild": "^0.25.10",
		"eslint": "^9.37.0",
		"globals": "^15.9.0",
		"markdownlint-cli": "^0.45.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"vscode-tmgrammar-test": "~0.1.3"
	}
}
