{
	"comments": {
		"lineComment": "//",
		"blockComment": ["/*", "*/"]
	},
	"folding": {
		"markers": {
			"start": "^\\s*//\\s*#?region\\b",
			"end": "^\\s*//\\s*#?endregion\\b"
		}
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		{"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
		{"open": "'", "close": "'", "notIn": ["string", "comment"]},
		{"open": "`", "close": "`", "notIn": ["string", "comment"]}
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"],
		["`", "`"]
	]
}
