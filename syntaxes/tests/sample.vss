// SYNTAX TEST "source.vss"
@accent: #2563eb;
//<------- variable.other.vss
//       ^^^^^^^ constant.numeric.color.hex.vss
light { @bg: #f1f5f9; @ink: #172033; }
//<------- keyword.control.at-rule.vss
//      ^^^ variable.other.vss
//                    ^^^^ variable.other.vss
//                          ^^^^^^^ constant.numeric.color.hex.vss
dark  { @bg: #172033; @ink: #f8fafc; }
//<------- keyword.control.at-rule.vss
//      ^^^ variable.other.vss
//           ^^^^^^^ constant.numeric.color.hex.vss
//                    ^^^^ variable.other.vss

Button { background: @accent; color: white; border-radius: 6px; }
//<------ entity.name.tag.vss
//       ^^^^^^^^^^ support.type.property-name.vss
//                   ^^^^^^^ variable.other.vss
//                            ^^^^^ support.type.property-name.vss
//                                          ^^^^^^^^^^^^^ support.type.property-name.vss
//                                                         ^^^ constant.numeric.vss
Button:hover { opacity: 0.92; }
//<------ entity.name.tag.vss
//    ^^^^^^ entity.other.attribute-name.pseudo-class.vss
//             ^^^^^^^ support.type.property-name.vss
//                      ^^^^ constant.numeric.vss
Button:disabled { opacity: 0.4; }
//<------ entity.name.tag.vss
//    ^^^^^^^^^ entity.other.attribute-name.pseudo-class.vss
//                ^^^^^^^ support.type.property-name.vss
//                         ^^^ constant.numeric.vss
Label.title { font-size: 22px; font-weight: bold; }
//<----- entity.name.tag.vss
//   ^^^^^^ entity.other.attribute-name.class.vss
//            ^^^^^^^^^ support.type.property-name.vss
//                       ^^^^ constant.numeric.vss
//                             ^^^^^^^^^^^ support.type.property-name.vss
Dropdown { color: @ink; }
//<-------- entity.name.tag.vss
//         ^^^^^ support.type.property-name.vss
//                ^^^^ variable.other.vss
Dropdown:focused { border-color: @accent; border-width: 1px; }
//<-------- entity.name.tag.vss
//      ^^^^^^^^ entity.other.attribute-name.pseudo-class.vss
//                 ^^^^^^^^^^^^ support.type.property-name.vss
//                               ^^^^^^^ variable.other.vss
//                                        ^^^^^^^^^^^^ support.type.property-name.vss
//                                                      ^^^ constant.numeric.vss

@media (max-width: 560px) {
//<------ keyword.control.at-rule.vss - variable.other.vss
//                 ^^^^^ constant.numeric.vss
	Label.title { font-size: 18px; }
//<~----- entity.name.tag.vss
//    ^^^^^^ entity.other.attribute-name.class.vss
//             ^^^^^^^^^ support.type.property-name.vss
//                        ^^^^ constant.numeric.vss
}

@container (min-width: 320px) {
//<---------- keyword.control.at-rule.vss - variable.other.vss
//                     ^^^^^ constant.numeric.vss
	.card { padding: 12px; }
//<~----- entity.other.attribute-name.class.vss
//       ^^^^^^^ support.type.property-name.vss
//                ^^^^ constant.numeric.vss
}
/* block comments are the only comments */
//<------------------------------------------ comment.block.vss
// line comments are not comments
//<-- - comment.line.double-slash.vss
View.accent { background: #f1f5f9; }
//<---- entity.name.tag.vss
//  ^^^^^^^ entity.other.attribute-name.class.vss
//            ^^^^^^^^^^ support.type.property-name.vss
//                        ^^^^^^^ constant.numeric.color.hex.vss - entity.other.attribute-name.id.vss
Label.dim { opacity: 50%; }
//<----- entity.name.tag.vss
//   ^^^^ entity.other.attribute-name.class.vss
//          ^^^^^^^ support.type.property-name.vss
//                   ^^^ constant.numeric.vss
@supports (container-queries) {
//<--------- keyword.control.at-rule.vss - variable.other.vss
	View.card { border-radius: 16px; }
//<~---- entity.name.tag.vss
//   ^^^^^ entity.other.attribute-name.class.vss
//           ^^^^^^^^^^^^^ support.type.property-name.vss
//                          ^^^^ constant.numeric.vss
}
