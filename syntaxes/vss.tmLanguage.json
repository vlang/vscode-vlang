{
	"name": "VSS",
	"scopeName": "source.vss",
	"fileTypes": [".vss"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#variables" },
		{ "include": "#at-rules" },
		{ "include": "#selectors" },
		{ "include": "#properties" },
		{ "include": "#values" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "name": "comment.line.double-slash.vss", "match": "//.*$" },
				{ "name": "comment.block.vss", "begin": "/\\*", "end": "\\*/" }
			]
		},
		"variables": {
			"patterns": [
				{ "name": "variable.other.vss", "match": "@[a-zA-Z_][a-zA-Z0-9_-]*" }
			]
		},
		"at-rules": {
			"patterns": [
				{ "name": "keyword.control.at-rule.vss", "match": "@(media|container|accent|bg|ink)\\b" },
				{ "name": "keyword.control.at-rule.vss", "match": "\\b(light|dark)\\s*\\{" }
			]
		},
		"selectors": {
			"patterns": [
				{ "name": "entity.name.tag.vss", "match": "\\b(Button|Label|Rectangle|View|Screen|Scroll)\\b" },
				{ "name": "entity.other.attribute-name.class.vss", "match": "\\.[a-zA-Z_][a-zA-Z0-9_-]*" },
				{ "name": "entity.other.attribute-name.id.vss", "match": "#[a-zA-Z_][a-zA-Z0-9_-]*" },
				{ "name": "entity.other.attribute-name.pseudo-class.vss", "match": ":[a-zA-Z_-]+" }
			]
		},
		"properties": {
			"patterns": [
				{ "name": "support.type.property-name.vss", "match": "\\b(background|color|border|radius|opacity|font-size|width|height|x|y|padding|margin|corner_radius|bold|align)\\b(?=\\s*:)" }
			]
		},
		"values": {
			"patterns": [
				{ "name": "constant.numeric.color.hex.vss", "match": "#[0-9a-fA-F]{3,8}\\b" },
				{ "name": "constant.numeric.vss", "match": "\\b\\d+(\\.\\d+)?(px|%)?\\b" },
				{ "name": "string.quoted.double.vss", "begin": "\"", "end": "\"" }
			]
		}
	}
}