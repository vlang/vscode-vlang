{
	"name": "VSS",
	"scopeName": "source.vss",
	"fileTypes": [".vss"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#at-rules" },
		{ "include": "#variables" },
		{ "include": "#values" },
		{ "include": "#selectors" },
		{ "include": "#properties" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "name": "comment.block.vss", "begin": "/\\*", "end": "\\*/" }
			]
		},
		"at-rules": {
			"patterns": [
				{
					"name": "keyword.control.at-rule.vss",
					"match": "@(import|keyframes|media|container|supports)\\b"
				},
				{
					"name": "keyword.control.at-rule.vss",
					"match": "^\\s*@[a-zA-Z_][a-zA-Z0-9_-]*\\b(?![\\w-]*\\s*:)"
				},
				{ "name": "keyword.control.at-rule.vss", "match": "\\b(light|dark)\\s*\\{" }
			]
		},
		"variables": {
			"patterns": [{ "name": "variable.other.vss", "match": "@[a-zA-Z_][a-zA-Z0-9_-]*" }]
		},
		"selectors": {
			"patterns": [
				{
					"name": "entity.name.tag.vss",
					"match": "(?i)\\b(screen|view|label|image|button|checkbox|dropdown|text_field|text_area|scroll|slider|switch_control|toggle_button|opengl)\\b"
				},
				{
					"name": "entity.other.attribute-name.class.vss",
					"match": "\\.[a-zA-Z_][a-zA-Z0-9_-]*"
				},
				{
					"name": "entity.other.attribute-name.id.vss",
					"match": "#[a-zA-Z_][a-zA-Z0-9_-]*"
				},
				{ "name": "entity.other.attribute-name.pseudo-class.vss", "match": ":[a-zA-Z_-]+" }
			]
		},
		"properties": {
			"patterns": [
				{
					"name": "support.type.property-name.vss",
					"match": "(?i)\\b(background-color|background-gradient|background|color|font-size|font-family|font-weight|font-style|text-align|text-decoration|border-radius|border-color|border-width|border|opacity|box-shadow|padding|margin|gap)\\b(?=\\s*:)"
				}
			]
		},
		"values": {
			"patterns": [
				{ "name": "constant.numeric.color.hex.vss", "match": "#[0-9a-fA-F]{3,8}\\b" },
				{ "name": "constant.numeric.vss", "match": "\\b\\d+(\\.\\d+)?(px|%)?(?!\\w)" },
				{ "name": "string.quoted.double.vss", "begin": "\"", "end": "\"" }
			]
		}
	}
}
